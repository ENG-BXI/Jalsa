# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
PORT="8000"
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="your_jwt_secret_here"

# Appwrite configuration
APPWRITE_API_KEY="your_appwrite_api_key_here"
APPWRITE_API_ENDPOINT="your_appwrite_api_endpoint_here"
APPWRITE_PROJECT_ID="your_appwrite_project_id_here"
APPWRITE_IMAGE_BUCKET_ID="your_appwrite_image_bucket_id_here"
# stream 
STREAM_API_KEY="your_stream_api_key_here"
STREAM_API_SECRET="your_stream_api_secret_here"
# redis
REDIS_USERNAME="default"
REDIS_PASSWORD="your_redis_password_here"
REDIS_HOST="your_redis_host_here"
REDIS_PORT="your_redis_port_here"